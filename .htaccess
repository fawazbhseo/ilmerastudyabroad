RewriteEngine On
DirectoryIndex index.php index.html

# One canonical sitemap endpoint, generated from the shared discovery helpers.
RewriteCond %{THE_REQUEST} \s/+sitemap(?:\.php)?[\s?] [NC]
RewriteRule ^sitemap(?:\.php)?$ /sitemap.xml [R=301,L]
RewriteRule ^sitemap\.xml$ sitemap.php [END]

# If someone requests about.php directly, redirect to /about (SEO-friendly, avoids duplicate content)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally serve the .php file when /about is requested (browser URL stays clean)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# Phase 24b: internal notes, scripts and audit data are not public website files.
<FilesMatch "(?i)(?:\.(?:md|py|cjs|log|bak|csv)$|^phase.*\.json$|^\.)">
    Require all denied
</FilesMatch>
# Git metadata must never be uploaded or served.
RedirectMatch 403 "(?i)^/\.git(?:/|$)"
