{
  "all_eight_payload_htaccess": [
    {
      "path": ".htaccess",
      "sha256": "660f6611834716f7befe4a29ff4c1e69832934cfc9764f3eab517a0b5e9351cb",
      "lines": [
        {
          "line": 1,
          "text": "RewriteEngine On"
        },
        {
          "line": 2,
          "text": "DirectoryIndex index.php index.html"
        },
        {
          "line": 3,
          "text": ""
        },
        {
          "line": 4,
          "text": "# One canonical sitemap endpoint, generated from the shared discovery helpers."
        },
        {
          "line": 5,
          "text": "RewriteCond %{THE_REQUEST} \\s/+sitemap(?:\\.php)?[\\s?] [NC]"
        },
        {
          "line": 6,
          "text": "RewriteRule ^sitemap(?:\\.php)?$ /sitemap.xml [R=301,L]"
        },
        {
          "line": 7,
          "text": "RewriteRule ^sitemap\\.xml$ sitemap.php [END]"
        },
        {
          "line": 8,
          "text": ""
        },
        {
          "line": 9,
          "text": "# If someone requests about.php directly, redirect to /about (SEO-friendly, avoids duplicate content)"
        },
        {
          "line": 10,
          "text": "RewriteCond %{THE_REQUEST} \\s/+(.+?)\\.php[\\s?] [NC]"
        },
        {
          "line": 11,
          "text": "RewriteRule ^ /%1 [R=301,L]"
        },
        {
          "line": 12,
          "text": ""
        },
        {
          "line": 13,
          "text": "# Internally serve the .php file when /about is requested (browser URL stays clean)"
        },
        {
          "line": 14,
          "text": "RewriteCond %{REQUEST_FILENAME} !-d"
        },
        {
          "line": 15,
          "text": "RewriteCond %{REQUEST_FILENAME}\\.php -f"
        },
        {
          "line": 16,
          "text": "RewriteRule ^(.*)$ $1.php [L]"
        },
        {
          "line": 17,
          "text": ""
        },
        {
          "line": 18,
          "text": "# Phase 24b: internal notes, scripts and audit data are not public website files."
        },
        {
          "line": 19,
          "text": "<FilesMatch \"(?i)(?:\\.(?:md|py|cjs|log|bak|csv)$|^phase.*\\.json$|^\\.)\">"
        },
        {
          "line": 20,
          "text": "    Require all denied"
        },
        {
          "line": 21,
          "text": "</FilesMatch>"
        },
        {
          "line": 22,
          "text": "# Git metadata must never be uploaded or served."
        },
        {
          "line": 23,
          "text": "RedirectMatch 403 \"(?i)^/\\.git(?:/|$)\""
        }
      ]
    },
    {
      "path": "assets/fonts/.htaccess",
