        {
          "line": 1,
          "text": "# Additive policy scoped only to this font directory. Parent rules unchanged."
        },
        {
          "line": 2,
          "text": "<IfModule mod_mime.c>"
        },
        {
          "line": 3,
          "text": "    AddType font/woff2 .woff2"
        },
        {
          "line": 4,
          "text": "</IfModule>"
        },
        {
          "line": 5,
          "text": "<IfModule mod_headers.c>"
        },
        {
          "line": 6,
          "text": "    <FilesMatch \"\\.woff2$\">"
        },
        {
          "line": 7,
          "text": "        Header set Cache-Control \"public, max-age=31536000, immutable\""
        },
        {
          "line": 8,
          "text": "    </FilesMatch>"
        },
        {
          "line": 9,
          "text": "</IfModule>"
        }
      ]
